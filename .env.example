# ===== CineMetrics — variáveis de ambiente =====
# Copie para .env (que NÃO vai pro git) e ajuste se quiser.

# --- MinIO (Data Lake S3) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Credenciais S3 usadas por Spark/boto3 (= MinIO)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_ENDPOINT_HOST=http://localhost:9000

# Buckets do medalhão
BRONZE_BUCKET=bronze
SILVER_BUCKET=silver
GOLD_BUCKET=gold

# --- Postgres (metadados Airflow + gold servido pro Metabase) ---
POSTGRES_USER=cinemetrics
POSTGRES_PASSWORD=cinemetrics
POSTGRES_DB=cinemetrics
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Kafka (eventos de streaming) ---
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_BOOTSTRAP_HOST=localhost:9094
KAFKA_TOPIC_EVENTS=streaming_events

# --- Ingestão batch ---
# Se TMDB_API_KEY estiver preenchida, o conector usa a API real do TMDb.
# Vazia => fallback automático para o dataset MovieLens (GroupLens), fonte batch real.
TMDB_API_KEY=
MOVIELENS_DATASET=ml-latest-small

# --- Geração de eventos sintéticos ---
EVENTS_PER_SECOND=20
EVENT_BURST_SECONDS=60
