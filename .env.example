# ===== CineMetrics — environment variables =====
# Copy to .env (which is NOT committed to git) and adjust as needed.

# --- MinIO (Data Lake S3) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# S3 credentials used by Spark/boto3 (= MinIO)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_ENDPOINT_HOST=http://localhost:9000

# Medallion buckets
BRONZE_BUCKET=bronze
SILVER_BUCKET=silver
GOLD_BUCKET=gold

# --- Postgres (Airflow metadata + gold served to Metabase) ---
POSTGRES_USER=cinemetrics
POSTGRES_PASSWORD=cinemetrics
POSTGRES_DB=cinemetrics
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Kafka (streaming events) ---
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_BOOTSTRAP_HOST=localhost:9094
KAFKA_TOPIC_EVENTS=streaming_events

# --- Batch ingestion ---
# If TMDB_API_KEY is set, the connector uses the real TMDb API.
# Empty => automatic fallback to the MovieLens dataset (GroupLens), a real batch source.
TMDB_API_KEY=
MOVIELENS_DATASET=ml-latest-small

# --- Synthetic event generation ---
EVENTS_PER_SECOND=20
EVENT_BURST_SECONDS=60
